# API configuration.
#
# Contains no secrets: this service holds no patient data and talks to nothing
# external. Committed as-is so `docker compose up` works on a fresh clone.

# Comma-separated list of origins allowed to call the API from a browser.
# Add your deployed dashboard origin here rather than widening this to "*".
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Uvicorn log level: critical | error | warning | info | debug
LOG_LEVEL=info
